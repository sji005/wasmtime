+// Associated fields can become tuples/ADTs only after generic substitution
+// (for example <[T] as Pointee>::Pointer = (u32, u32)). Ask rustc to normalize
+// the instantiated Rust type before deriving structural ghost operations.
+// Failure preserves the original alias: it never substitutes an assumed type.
+fn instantiated_field_ty(
+    genv: GlobalEnv,
+    owner: DefId,
+    field_id: DefId,
+    args: &GenericArgs,
+) -> QueryResult<Ty> {
+    let ty = genv.lower_type_of(field_id)?.subst(args);
+    let tcx = genv.tcx();
+    let typing_env = rustc_middle::ty::TypingEnv::non_body_analysis(tcx, owner);
+    match tcx.try_normalize_erasing_regions(
+        typing_env,
+        rustc_middle::ty::Unnormalized::new(ty.to_rustc(tcx)),
+    ) {
+        Ok(normalized) => normalized
+            .lower(tcx)
+            .map_err(|err| QueryErr::unsupported(field_id, err.into_err())),
+        Err(_) => Ok(ty),
+    }
+}
