{
  "scope": "Checker diagnostics for a minimal worker-shaped Rust program",
  "cases": [
    {
      "name": "slice",
      "runs": [
        {
          "command": [
            "rustc",
            "--edition=2024",
            "--crate-type=lib",
            "--target",
            "x86_64-unknown-linux-gnu",
            "--color=never",
            "--out-dir",
            "/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/worker-coercion",
            "/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/worker-coercion/slice.rs"
          ],
          "log": "slice-rustc.log",
          "exit_code": 0
        },
        {
          "command": [
            "flux",
            "--edition=2024",
            "--crate-type=lib",
            "--target",
            "x86_64-unknown-linux-gnu",
            "--color=never",
            "--out-dir",
            "/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/worker-coercion",
            "--cfg",
            "flux",
            "-Fcheck-overflow=strict",
            "-Fstd-extern-specs=on",
            "-Fdump-rty=on",
            "-Fallow-raw-deref=none",
            "-Flog-dir=/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/worker-coercion/slice",
            "-Zunstable-options",
            "--extern",
            "force:fd_read_file_primitive=/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/file-primitive-specs/libfd_read_file_primitive.rlib",
            "--extern",
            "force:fd_read_file_primitive=/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/file-primitive-specs/libfd_read_file_primitive.rmeta",
            "-L",
            "dependency=/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/file-primitive-specs",
            "/home/runner/work/wasmtime/wasmtime/artifacts/fd-read/worker-coercion/slice.rs"
          ],
          "log": "slice-flux.log",
          "exit_code": 0
        }
